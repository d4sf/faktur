FROM node:22-alpine AS dev

# python3/make/g++ son para `npm ci` de better-sqlite3: el paquete trae
# binding.gyp y npm le aplica su default `node-gyp rebuild`. Solo la imagen dev
# los carga; la de producción los compila en su etapa de deps y no los hereda.
# python3/make/g++ son para `npm ci` de better-sqlite3: verificado que sin
# ellos el build aborta con "Could not find any Python installation". El
# Containerfile tiene el detalle. Esta imagen dev sí los carga de forma
# permanente; la de producción no.
RUN apk add --no-cache bash curl git python3 make g++

WORKDIR /app

COPY package.json package-lock.json ./
COPY api/package.json ./api/
COPY web/package.json ./web/
RUN npm ci

COPY . .

EXPOSE 3000 5173

CMD ["npm", "run", "dev"]
