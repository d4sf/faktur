APP_PORT=3000
API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

# Opcional. Sin esta, el motor de reglas, el CSV y la bandeja funcionan igual;
# solo /extract falla cuando se usa.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Opcional. Solo se usa en T17.
NOTIFIER_WEBHOOK_URL=

# Rate limiting (opcionales, tienen defaults sensatos).
# Límite global por IP (requests por ventana).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Upload de facturas.
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
# Explicación con IA.
RATE_LIMIT_EXPLAIN_MAX=5
RATE_LIMIT_EXPLAIN_WINDOW_MS=60000
# Reset de base (admin).
RATE_LIMIT_ADMIN_MAX=3
RATE_LIMIT_ADMIN_WINDOW_MS=60000
# Prueba de webhook de Slack.
RATE_LIMIT_WEBHOOK_TEST_MAX=5
RATE_LIMIT_WEBHOOK_TEST_WINDOW_MS=60000