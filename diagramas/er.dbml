// Database Markup Language (DBML) Definition
// Sincronizado con docs/propuesta_modelo_ER_faktur.md y diagramas/er.mmd

Table CATEGORIES {
  name varchar [pk, note: 'Infraestructura | Diseno | Marketing | Legal | Software | Retail']
}

Table VENDORS {
  id varchar [pk]
  tax_id varchar [unique, not null, note: 'UPPER, TRIM']
  display_name varchar
  category varchar [ref: > CATEGORIES.name, note: 'FK a categories']
  status varchar [note: 'ALLOWLISTED | BLOCKLISTED']
  historical_avg_usd float [note: 'para drift x1.40']
}

Table INVOICES {
  id varchar [pk]
  vendor_id varchar [ref: > VENDORS.id, note: 'nullable -> FRENAR regla 1']
  invoice_number varchar [note: 'folio']
  status varchar [note: 'recibida | extraida | decidida | pendiente_aprobacion | aprobada | negada | frenada']
  file_hash varchar [unique, not null, note: 'SHA-256, UNIQUE a nivel factura canonica (RI-1)']
  currency varchar [ref: > FX_RATES.currency, note: 'FK a fx_rates (RI-7)']
  total_amount float [note: 'original']
  fx_rate_used float [note: 'congelada']
  total_usd float [note: 'evaluada']
  extraction_confidence float [note: '0..1, bajo el umbral -> ESCALAR']
  extraction_json varchar [note: 'crudo validado']
}

Table INGEST_ATTEMPTS {
  id varchar [pk]
  invoice_id varchar [note: 'nullable, se llena solo si este intento creo la factura']
  file_name varchar
  mime_type varchar
  byte_size int
  file_hash varchar [note: 'indexado, NO unique: el reenvijo se registra y se frena']
  attempt_status varchar [note: 'RECIBIDA | DUPLICADA | RECHAZADA']
  duplicate_of_invoice_id varchar [note: 'apunta a la factura canonica si DUPLICADA']

  indexes {
    file_hash
    invoice_id
  }
}

Table LINE_ITEMS {
  id varchar [pk]
  invoice_id varchar [ref: > INVOICES.id]
  description varchar
  quantity float
  unit_price float
  total float
}

Table POLICIES {
  version varchar [pk, note: 'v1, v2...']
  auto_approval_threshold_usd float [note: '1000.0']
  monthly_budget_usd float [note: '5000.0']
  vendor_drift_factor float [note: '1.40']
  allowed_currencies varchar [note: 'lista']
  is_active boolean [note: 'una sola']
}

Table POLICY_CATEGORY_BUDGETS {
  policy_version varchar [ref: > POLICIES.version]
  category varchar [ref: > CATEGORIES.name, note: 'FK a categories']
  budget_usd float

  indexes {
    (policy_version, category) [pk]
  }
}

Table FX_RATES {
  currency varchar [pk]
  rate_to_usd float
}

Table DECISIONS {
  id varchar [pk]
  invoice_id varchar [note: 'nullable, NO unique: append-only, RI-8']
  ingest_attempt_id varchar [note: 'nullable, ancla la decision de un reenvio duplicado']
  verdict varchar [note: 'PAGAR | FRENAR | ESCALAR']
  reason_code varchar [note: 'diez codigos canonicos, ver propuesta ER 2.8.1']
  explanation varchar [note: 'motivo legible en lenguaje natural']
  policy_version varchar [ref: > POLICIES.version, note: 'obligatoria']
  amount_usd_evaluated float [note: 'copia congelada del total_usd']
  decided_by varchar [note: 'AGENTE | HUMANO']
}

Table APPROVALS {
  id varchar [pk]
  decision_id varchar [unique, ref: - DECISIONS.id]
  invoice_id varchar [ref: > INVOICES.id, note: 'desnormalizada para la bandeja']
  status varchar [note: 'PENDIENTE | APROBADA | NEGADA']
  resolved_by varchar [note: 'quien']
  comment varchar [note: 'por que']
  override_with_overbudget boolean
}

Table LEDGER_ENTRIES {
  id varchar [pk]
  invoice_id varchar [ref: > INVOICES.id]
  decision_id varchar [ref: > DECISIONS.id]
  amount_usd float [note: 'solo PAGAR final']
  entry_type varchar [note: 'COMPROMISO_PAGAR']
}

Table NOTIFICATIONS {
  id varchar [pk]
  channel varchar [note: 'SLACK_CARD | WEBHOOK | CONSOLE']
  payload_json varchar
  status varchar [note: 'PENDIENTE | ENVIADA | FALLIDA']
}

Ref: INGEST_ATTEMPTS.invoice_id > INVOICES.id [delete: set null]
Ref: INGEST_ATTEMPTS.duplicate_of_invoice_id > INVOICES.id [delete: set null]
Ref: DECISIONS.invoice_id > INVOICES.id [delete: cascade]
Ref: DECISIONS.ingest_attempt_id > INGEST_ATTEMPTS.id [delete: cascade]